<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rts.Tools.SimHost</RootNamespace>
    <AssemblyName>sim-host</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Self-contained publish targets (Task 2): no global runtime discovery.
         Publish with RuntimeIdentifier above plus self contained single file options. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../sim/Sim.csproj" />
  </ItemGroup>
</Project>
